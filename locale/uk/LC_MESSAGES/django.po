#: apps/accounts/forms.py:45
msgid "Type a password, or press the button to generate one."
msgstr "Введіть пароль або натисніть кнопку, щоб його згенерувати."

#: apps/accounts/forms.py:47
msgid "Type a password."
msgstr "Введіть пароль."

#: apps/accounts/forms.py:51
msgid "The two passwords do not match."
msgstr "Паролі не збігаються."

#: apps/accounts/forms.py:63 apps/accounts/forms.py:251
msgid "Password again"
msgstr "Пароль ще раз"

#: apps/accounts/forms.py:70 apps/accounts/forms.py:119 apps/accounts/forms.py:245
msgid "Name shown in the app"
msgstr "Ім’я в застосунку"

#: apps/accounts/forms.py:74 apps/accounts/forms.py:241
msgid "Used to log in. It cannot be changed later."
msgstr "Потрібне для входу. Пізніше його не можна змінити."

#: apps/accounts/forms.py:75 apps/accounts/forms.py:247
msgid "For example: Olena Kovalenko."
msgstr "Наприклад: Олена Коваленко."

#: apps/accounts/forms.py:84
msgid "At least 8 characters. Or leave it empty and create the account with a generated password."
msgstr ""
"Щонайменше 8 символів. Або залиште порожнім і створіть обліковий запис зі згенерованим паролем."

#: apps/accounts/forms.py:93 apps/accounts/forms.py:273 apps/accounts/views.py:98
msgid "This username is already taken."
msgstr "Це ім’я користувача вже зайняте."

#: apps/accounts/forms.py:121
msgid "Active (can log in)"
msgstr "Активний (може входити)"

#: apps/accounts/forms.py:124
msgid ""
"Turn off to stop this person logging in. Nothing is deleted, and their open sessions keep working "
"for students."
msgstr ""
"Вимкніть, щоб ця людина більше не могла входити. Нічого не видаляється, а її відкриті сесії й "
"надалі працюють для учнів."

#: apps/accounts/forms.py:137
msgid "You cannot change your own role or deactivate yourself."
msgstr "Ви не можете змінити власну роль або деактивувати себе."

#: apps/accounts/forms.py:142
msgid "This account is a superuser, so it always has the admin role."
msgstr "Це суперкористувач, тож він завжди має роль адміністратора."

#: apps/accounts/forms.py:166
msgid "New password"
msgstr "Новий пароль"

#: apps/accounts/forms.py:167
msgid "New password again"
msgstr "Новий пароль ще раз"

#: apps/accounts/forms.py:172 apps/accounts/forms.py:258
msgid "At least 8 characters."
msgstr "Щонайменше 8 символів."

#: apps/accounts/forms.py:185
msgid "School name"
msgstr "Назва школи"

#: apps/accounts/forms.py:186
msgid "Let teachers register themselves"
msgstr "Дозволити вчителям реєструватися самостійно"

#: apps/accounts/forms.py:187 apps/accounts/forms.py:233
msgid "Invite code"
msgstr "Код запрошення"

#: apps/accounts/forms.py:190
msgid "Kept for later use, for example in printed sheets."
msgstr "Зберігається для подальшого використання, наприклад у друкованих аркушах."

#: apps/accounts/forms.py:191
msgid ""
"Off by default. When on, anyone who knows the invite code can create a teacher account at the "
"registration page."
msgstr ""
"Типово вимкнено. Коли ввімкнено, будь-хто, хто знає код запрошення, може створити обліковий запис "
"вчителя на сторінці реєстрації."

#: apps/accounts/forms.py:195
msgid "People must type this code to register. Share it only with colleagues."
msgstr "Щоб зареєструватися, потрібно ввести цей код. Передавайте його лише колегам."

#: apps/accounts/forms.py:212
msgid "Set an invite code before turning registration on. You can generate one."
msgstr "Задайте код запрошення, перш ніж вмикати реєстрацію. Його можна згенерувати."

#: apps/accounts/forms.py:217
msgid "The invite code needs at least %(n)s characters."
msgstr "Код запрошення має містити щонайменше %(n)s символів."

#: apps/accounts/forms.py:269
msgid "The invite code is not correct."
msgstr "Код запрошення неправильний."

#: apps/accounts/manage_views.py:99
msgid "Account “%(name)s” created."
msgstr "Обліковий запис «%(name)s» створено."

#: apps/accounts/manage_views.py:126
msgid "Changes saved."
msgstr "Зміни збережено."

#: apps/accounts/manage_views.py:147
msgid "The password of “%(name)s” was changed."
msgstr "Пароль користувача «%(name)s» змінено."

#: apps/accounts/manage_views.py:176
msgid "“%(name)s” can log in again."
msgstr "«%(name)s» знову може входити."

#: apps/accounts/manage_views.py:180
msgid "“%(name)s” can no longer log in. Their data is kept."
msgstr "«%(name)s» більше не може входити. Дані збережено."

#: apps/accounts/manage_views.py:197
msgid "Settings saved with a new invite code."
msgstr "Налаштування збережено з новим кодом запрошення."

#: apps/accounts/manage_views.py:199 apps/assessments/editor_views.py:82
msgid "Settings saved."
msgstr "Налаштування збережено."

#: apps/accounts/models.py:8
msgid "Admin"
msgstr "Адміністратор"

#: apps/accounts/services.py:70
msgid "You cannot deactivate your own account."
msgstr "Ви не можете деактивувати власний обліковий запис."

#: apps/accounts/services.py:72
msgid "You cannot change your own role. Ask another admin to do it."
msgstr "Ви не можете змінити власну роль. Попросіть про це іншого адміністратора."

#: apps/accounts/services.py:79
msgid "This is the last active admin. Make someone else an admin first."
msgstr "Це останній активний адміністратор. Спершу призначте адміністратором когось іншого."

#: apps/accounts/views.py:48
msgid "Too many failed sign-in attempts. Wait a few minutes."
msgstr "Забагато невдалих спроб входу. Зачекайте кілька хвилин."

#: apps/accounts/views.py:102
msgid "Your account is ready. Welcome!"
msgstr "Ваш обліковий запис готовий. Ласкаво просимо!"

#: apps/assessments/editing.py:210
msgid "Points must be a number, for example 1 or 1.5."
msgstr "Бали мають бути числом, наприклад 1 або 1,5."

#: apps/assessments/editing.py:234
msgid "The penalty must be a number between 0 and 1."
msgstr "Штраф має бути числом від 0 до 1."

#: apps/assessments/editing.py:242
msgid "The number of answers to choose must be a whole number."
msgstr "Кількість відповідей, які треба вибрати, має бути цілим числом."

#: apps/assessments/editing.py:254
msgid "The tolerance must be a number."
msgstr "Допуск має бути числом."

#: apps/assessments/editing.py:412
msgid "The time limit must be a whole number of minutes, or empty."
msgstr "Обмеження часу має бути цілою кількістю хвилин або порожнім."

#: apps/assessments/editing.py:417
msgid "The number of attempts must be a whole number, at least 1."
msgstr "Кількість спроб має бути цілим числом, не менше 1."

#: apps/assessments/editing.py:421
msgid "The pass mark must be a percentage between 0 and 100."
msgstr "Прохідний бал має бути відсотком від 0 до 100."

#: apps/assessments/editor_views.py:46
msgid "Give the test a title."
msgstr "Вкажіть назву тесту."

#: apps/assessments/editor_views.py:58
msgid "Test created. Add the first question."
msgstr "Тест створено. Додайте перше запитання."

#: apps/assessments/editor_views.py:156
msgid "Question saved."
msgstr "Запитання збережено."

#: apps/assessments/editor_views.py:182
msgid "Question deleted."
msgstr "Запитання видалено."

#: apps/assessments/editor_views.py:212
msgid "Question duplicated."
msgstr "Запитання дубльовано."

#: apps/assessments/editor_views.py:223
msgid "Test \"%(title)s\" deleted."
msgstr "Тест «%(title)s» видалено."

#: apps/assessments/editor_views.py:239
msgid "Fix the errors in the test before previewing it."
msgstr "Виправте помилки в тесті, перш ніж переглядати його."

#: apps/assessments/models.py:34
msgid "Draft"
msgstr "Чернетка"

#: apps/assessments/models.py:36
msgid "Archived"
msgstr "Заархівовано"

#: apps/assessments/services.py:15
msgid "My tests"
msgstr "Мої тести"

#: apps/assessments/views.py:23
msgid "Single choice"
msgstr "Одна відповідь"

#: apps/assessments/views.py:24
msgid "Multiple choice"
msgstr "Кілька відповідей"

#: apps/assessments/views.py:25
msgid "Choose N"
msgstr "Вибір N відповідей"

#: apps/assessments/views.py:26
msgid "Short answer"
msgstr "Коротка відповідь"

#: apps/assessments/views.py:27
msgid "Open (manual grading)"
msgstr "Відкрите (ручне оцінювання)"

#: apps/assessments/views.py:98 apps/people/forms.py:154 apps/people/importing.py:366
#: apps/people/importing.py:402
msgid "The file is too large (limit 2 MB)."
msgstr "Файл завеликий (ліміт — 2 МБ)."

#: apps/assessments/views.py:104 apps/people/importing.py:299
msgid "The text is too large (limit 2 MB)."
msgstr "Текст завеликий (ліміт — 2 МБ)."

#: apps/assessments/views.py:110
msgid "Paste the test JSON or choose a file first."
msgstr "Спочатку вставте JSON тесту або виберіть файл."

#: apps/assessments/views.py:116
msgid "Test created as a draft. Publish it to use it."
msgstr "Тест створено як чернетку. Опублікуйте його, щоб користуватися ним."

#: apps/assessments/views.py:169
msgid "Cannot publish: the test has errors. See the list below."
msgstr "Не вдалося опублікувати: у тесті є помилки. Перегляньте список нижче."

#: apps/assessments/views.py:171
msgid "Published as revision %(n)s."
msgstr "Опубліковано як версію %(n)s."

#: apps/assessments/views.py:175
msgid "Nothing changed since revision %(n)s, so no new revision was created."
msgstr "Від версії %(n)s змін немає, тому нову версію не створено."

#: apps/assessments/views.py:187
msgid "Cannot export: the test has errors."
msgstr "Не вдалося експортувати: у тесті є помилки."

#: apps/core/datadir.py:30
msgid ""
"The data folder %(path)s is inside '%(name)s'. Sync clients can corrupt the SQLite database. Move "
"it outside (set KT_DATA_DIR, default %(default)s)."
msgstr ""
"Папка з даними %(path)s розташована всередині «%(name)s». Клієнти синхронізації можуть пошкодити "
"базу даних SQLite. Перенесіть її за межі такої папки (задайте KT_DATA_DIR; типове значення — "
"%(default)s)."

#: apps/core/management/commands/serve.py:52
msgid "Collecting static files..."
msgstr "Збирання статичних файлів..."

#: apps/core/management/commands/serve.py:56
msgid "Data folder: %(path)s"
msgstr "Папка з даними: %(path)s"

#: apps/core/management/commands/serve.py:59
msgid "WARNING: %(text)s"
msgstr "УВАГА: %(text)s"

#: apps/core/management/commands/serve.py:62
msgid "Open on this computer or on phones in the same network:"
msgstr "Відкрийте на цьому комп’ютері або на телефонах у тій самій мережі:"

#: apps/core/management/commands/serve.py:70
msgid "If phones cannot connect, run once as administrator (PowerShell):"
msgstr ""
"Якщо телефони не можуть підключитися, виконайте один раз від імені адміністратора (PowerShell):"

#: apps/core/management/commands/serve.py:74
msgid "Press Ctrl+C to stop."
msgstr "Натисніть Ctrl+C, щоб зупинити."

#: apps/core/management/commands/serve.py:84
msgid "Stopped."
msgstr "Зупинено."

#: apps/core/management/commands/serve.py:96
msgid "Scan to open %(url)s"
msgstr "Скануйте, щоб відкрити %(url)s"

#: apps/delivery/forms.py:13
msgid "%(name)s (%(n)d student)"
msgid_plural "%(name)s (%(n)d students)"
msgstr[0] "%(name)s (%(n)d учень)"
msgstr[1] "%(name)s (%(n)d учні)"
msgstr[2] "%(name)s (%(n)d учнів)"

#: apps/delivery/forms.py:17
msgid "%(n)d without a PIN"
msgstr "без PIN-коду: %(n)d"

#: apps/delivery/forms.py:32
msgid "Session title"
msgstr "Назва сесії"

#: apps/delivery/forms.py:34
msgid "Access code (optional)"
msgstr "Код доступу (необов’язково)"

#: apps/delivery/forms.py:37
msgid "Takers must type this code to start. Leave empty for an open session."
msgstr ""
"Щоб розпочати, учні мають ввести цей код. Залиште поле порожнім, якщо сесія відкрита для всіх."

#: apps/delivery/forms.py:40
msgid "Class (group)"
msgstr "Клас (група)"

#: apps/delivery/forms.py:43
msgid "No class: students type their own name"
msgstr "Без класу: учні вводять ім’я самі"

#: apps/delivery/forms.py:44
msgid ""
"Pick a class and students choose their name from its list; their results land on their profile "
"automatically."
msgstr ""
"Оберіть клас, і учні виберуть своє ім’я зі списку; їхні результати потраплять у профіль "
"автоматично."

#: apps/delivery/forms.py:48
msgid "Choose one of your own classes."
msgstr "Оберіть один зі своїх класів."

#: apps/delivery/forms.py:51
msgid "Ask for a personal PIN"
msgstr "Запитувати особистий PIN-код"

#: apps/delivery/forms.py:53
msgid ""
"Students also type the PIN from their card. Students without a PIN cannot be picked in a PIN "
"session."
msgstr ""
"Учні також вводять PIN-код зі своєї картки. Учнів без PIN-коду не можна вибрати в сесії з PIN-"
"кодом."

#: apps/delivery/forms.py:81
msgid "A personal PIN needs a class. Choose a class above, or untick this box."
msgstr "Для особистого PIN-коду потрібен клас. Оберіть клас вище або зніміть цю позначку."

#: apps/delivery/models.py:50
msgid "Auto-submitted"
msgstr "Надіслано автоматично"

#: apps/delivery/models.py:88
msgid "Unanswered"
msgstr "Без відповіді"

#: apps/delivery/models.py:89
msgid "Graded"
msgstr "Оцінено"

#: apps/delivery/models.py:91
msgid "Reviewed"
msgstr "Перевірено"

#: apps/delivery/roster.py:107
msgid "This name has no PIN yet. Ask your teacher."
msgstr "Для цього імені ще немає PIN-коду. Запитайте вчителя."

#: apps/delivery/roster.py:110
msgid "Too many wrong PINs for this name. Please try again in a few minutes."
msgstr "Забагато неправильних PIN-кодів для цього імені. Спробуйте ще раз за кілька хвилин."

#: apps/delivery/roster.py:113
msgid "Please type your PIN."
msgstr "Будь ласка, введіть свій PIN-код."

#: apps/delivery/roster.py:116
msgid "The PIN is not correct."
msgstr "PIN-код неправильний."

#: apps/delivery/roster.py:158 apps/delivery/taker_views.py:260
msgid "Please choose your name from the list."
msgstr "Будь ласка, оберіть своє ім’я зі списку."

#: apps/delivery/roster.py:164 apps/delivery/taker_views.py:266
msgid "You have already taken this test."
msgstr "Ви вже проходили цей тест."

#: apps/delivery/services.py:78 apps/people/forms.py:81 apps/people/models.py:39
msgid "Full name"
msgstr "Прізвище та ім’я"

#: apps/delivery/taker_views.py:243
msgid "The access code is not correct."
msgstr "Код доступу неправильний."

#: apps/delivery/taker_views.py:252
msgid "Please fill in: %(field)s."
msgstr "Будь ласка, заповніть поле: %(field)s."

#: apps/delivery/taker_views.py:451
msgid "Not answered"
msgstr "Без відповіді"

#: apps/delivery/taker_views.py:454
msgid "Awaiting review"
msgstr "Очікує перевірки"

#: apps/delivery/taker_views.py:458
msgid "Incorrect"
msgstr "Неправильно"

#: apps/delivery/taker_views.py:459 apps/reports/data.py:95
msgid "Partly correct"
msgstr "Частково правильно"

#: apps/delivery/views.py:122
msgid "This class has no active students yet. Add students before you share the link."
msgstr "У цьому класі ще немає активних учнів. Додайте учнів, перш ніж ділитися посиланням."

#: apps/delivery/views.py:127
msgid ""
"%(n)d student of this class has no PIN yet and cannot be picked in this session. Generate PINs on "
"the class page."
msgid_plural ""
"%(n)d students of this class have no PIN yet and cannot be picked in this session. Generate PINs "
"on the class page."
msgstr[0] ""
"%(n)d учень цього класу ще не має PIN-коду й не може бути вибраний у цій сесії. Створіть PIN-коди "
"на сторінці класу."
msgstr[1] ""
"%(n)d учні цього класу ще не мають PIN-коду й не можуть бути вибрані в цій сесії. Створіть PIN-"
"коди на сторінці класу."
msgstr[2] ""
"%(n)d учнів цього класу ще не мають PIN-коду й не можуть бути вибрані в цій сесії. Створіть PIN-"
"коди на сторінці класу."

#: apps/delivery/views.py:190
msgid "Session reopened. Students can join again with the same link and code."
msgstr "Сесію відкрито знову. Учні можуть приєднатися за тим самим посиланням і кодом."

#: apps/delivery/views.py:200
msgid "Session deleted."
msgstr "Сесію видалено."

#: apps/delivery/views.py:222
msgid "Session closed. %(count)d unfinished attempt was submitted automatically."
msgid_plural "Session closed. %(count)d unfinished attempts were submitted automatically."
msgstr[0] "Сесію закрито. %(count)d незавершену спробу надіслано автоматично."
msgstr[1] "Сесію закрито. %(count)d незавершені спроби надіслано автоматично."
msgstr[2] "Сесію закрито. %(count)d незавершених спроб надіслано автоматично."

#: apps/delivery/views.py:230
msgid "Session closed."
msgstr "Сесію закрито."

#: apps/delivery/views.py:239
msgid "same name"
msgstr "те саме ім’я"

#: apps/delivery/views.py:240
msgid "same words"
msgstr "ті самі слова"

#: apps/delivery/views.py:241
msgid "similar"
msgstr "схоже"

#: apps/delivery/views.py:262
msgid "No class"
msgstr "Без класу"

#: apps/delivery/views.py:344
msgid ""
"One of the chosen students is not available (any more). Nothing was saved. Check the list and try "
"again."
msgstr ""
"Одного з вибраних учнів недоступно (вже). Нічого не збережено. Перевірте список і спробуйте ще "
"раз."

#: apps/delivery/views.py:352
msgid "Saved: %(n)d attempt updated."
msgid_plural "Saved: %(n)d attempts updated."
msgstr[0] "Збережено: оновлено %(n)d спробу."
msgstr[1] "Збережено: оновлено %(n)d спроби."
msgstr[2] "Збережено: оновлено %(n)d спроб."

#: apps/delivery/views.py:360
msgid "Nothing to change."
msgstr "Нічого змінювати."

#: apps/people/forms.py:32
msgid "Enter a name with letters or digits."
msgstr "Введіть назву з літерами або цифрами."

#: apps/people/forms.py:39
msgid "Enter a name with letters."
msgstr "Введіть ім’я з літерами."

#: apps/people/forms.py:48
msgid "Group name"
msgstr "Назва групи"

#: apps/people/forms.py:49 apps/people/models.py:17
msgid "Note"
msgstr "Примітка"

#: apps/people/forms.py:50
msgid "Archived (hidden from the list; students and results are kept)"
msgstr "В архіві (прихована зі списку; учні та результати зберігаються)"

#: apps/people/forms.py:57
msgid "For example 7-A or Physics, evening course."
msgstr "Наприклад, 7-А або Фізика, вечірні курси."

#: apps/people/forms.py:65 apps/people/views_roster.py:100 apps/people/views_roster.py:145
msgid "You already have a group with this name."
msgstr "У вас уже є група з такою назвою."

#: apps/people/forms.py:84
msgid "Active (untick when the student has left the class)"
msgstr "Активний (зніміть позначку, коли учень вибув із класу)"

#: apps/people/forms.py:103
msgid "Optional, 3 to 8 digits. Used to confirm identity in group sessions."
msgstr "Необов’язково, від 3 до 8 цифр. Використовується для підтвердження особи в групових сесіях."

#: apps/people/forms.py:113
msgid "The PIN must be 3 to 8 digits."
msgstr "PIN має складатися з 3–8 цифр."

#: apps/people/forms.py:122
msgid "Another student in this group already has this PIN."
msgstr "Інший учень у цій групі вже має такий PIN."

#: apps/people/forms.py:132
