msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "A variant cannot be added to this test."
msgstr "До цього тесту не можна додати варіант."

msgid "%(name)s added as a copy. Change its questions so that it differs."
msgstr "Додано «%(name)s» як копію. Змініть у ньому питання, щоб він відрізнявся."

msgid "%(name)s deleted."
msgstr "«%(name)s» видалено."

msgid "Variant %(n)s"
msgstr "Варіант %(n)s"

msgid "%(n)s variant"
msgid_plural "%(n)s variants"
msgstr[0] "%(n)s варіант"
msgstr[1] "%(n)s варіанти"
msgstr[2] "%(n)s варіантів"

msgid "every student gets one of them, in turn"
msgstr "кожен учень отримує один із них, по черзі"

msgid "Delete variant"
msgstr "Видалити варіант"

msgid "Add a question to %(name)s"
msgstr "Додати питання до «%(name)s»"

msgid "Another variant starts as a copy of the last one; then change its questions."
msgstr "Новий варіант створюється як копія останнього; після цього змініть у ньому питання."

msgid "Variants are parallel versions of the test: every student gets one of them, so neighbours answer different questions. A new variant starts as a copy of these questions; then change them."
msgstr "Варіанти — це паралельні версії тесту: кожен учень отримує одну з них, тож сусіди по парті відповідають на різні питання. Новий варіант створюється як копія цих питань; після цього змініть їх."

msgid "Add a variant"
msgstr "Додати варіант"

msgid "Delete %(name)s?"
msgstr "Видалити «%(name)s»?"

msgid "Its %(n)s question is deleted with it."
msgid_plural "Its %(n)s questions are deleted with it."
msgstr[0] "Разом із ним буде видалено %(n)s питання."
msgstr[1] "Разом із ним буде видалено %(n)s питання."
msgstr[2] "Разом із ним буде видалено %(n)s питань."

msgid "One variant will be left, so the test becomes a test without variants: every student gets the same questions."
msgstr "Залишиться один варіант, тому тест стане тестом без варіантів: усі учні отримають однакові питання."

msgid "Published revisions and finished sessions are not affected. The variant is removed from the draft only."
msgstr "Опубліковані версії та завершені сесії не змінюються. Варіант видаляється лише з чернетки."

msgid "Paste a Knowledge Tester test (JSON) or choose a file."
msgstr "Вставте тест Knowledge Tester (JSON) або виберіть файл."

msgid "To have an AI write the test from a textbook, copy the prompt on the <a href=\"%(help_url)s\">Help</a> page."
msgstr "Щоб ШІ склав тест за підручником, скопіюйте промпт на сторінці <a href=\"%(help_url)s\">Довідка</a>."

msgid "Every student gets one of them, in turn."
msgstr "Кожен учень отримує один із них, по черзі."

msgid "Help"
msgstr "Довідка"

msgid "A test from a textbook with an AI assistant"
msgstr "Тест за підручником за допомогою ШІ"

msgid "A chat assistant that reads PDF files (Claude, ChatGPT, Gemini and others) can write the test for you. You check it and import it here."
msgstr "Чат-асистент, який уміє читати PDF (Claude, ChatGPT, Gemini та інші), може скласти тест за вас. Ви перевіряєте його й імпортуєте сюди."

msgid "Open a new chat with the assistant and attach the PDF of the textbook (or only the chapter you need)."
msgstr "Відкрийте новий чат з асистентом і прикріпіть PDF підручника (або лише потрібний розділ)."

msgid "Copy the prompt below, fill in the lines in square brackets under “ПАРАМЕТРИ ТЕСТУ” (subject, pages, number of questions, number of variants, time) and send it."
msgstr "Скопіюйте промпт нижче, заповніть рядки у квадратних дужках у розділі «ПАРАМЕТРИ ТЕСТУ» (предмет, сторінки, кількість питань, кількість варіантів, час) і надішліть."

msgid "Copy the answer and paste it on the <a href=\"%(import_url)s\">Import a test</a> page. If the import reports errors, copy them back into the same chat."
msgstr "Скопіюйте відповідь і вставте її на сторінці <a href=\"%(import_url)s\">Імпортувати тест</a>. Якщо імпорт покаже помилки, скопіюйте їх назад у той самий чат."

msgid "Read the test before the lesson (the Preview button): assistants make mistakes. The “Ключ” request below gives you the answers with quotes from the textbook."
msgstr "Перечитайте тест перед уроком (кнопка «Попередній перегляд»): асистенти помиляються. Запит «Ключ» нижче дасть відповіді з цитатами з підручника."

msgid "Prompt"
msgstr "Промпт"

msgid "in Ukrainian; the test is written in the language of the textbook"
msgstr "українською; тест буде мовою підручника"

msgid "Copied"
msgstr "Скопійовано"

msgid "Select the text and copy it by hand"
msgstr "Виділіть текст і скопіюйте його вручну"

msgid "Copy the prompt"
msgstr "Скопіювати промпт"

msgid "Click into the text, select everything (Ctrl+A) and copy it (Ctrl+C)."
msgstr "Клацніть у тексті, виділіть усе (Ctrl+A) і скопіюйте (Ctrl+C)."

msgid "The prompt file was not found. It should be at %(path)s in the program folder."
msgstr "Файл із промптом не знайдено. Він має бути за адресою %(path)s у папці програми."

msgid "Follow-up requests"
msgstr "Наступні запити"

msgid "Send them in the same chat, after the test is written."
msgstr "Надсилайте їх у той самий чат, коли тест уже складено."

msgid "Copy"
msgstr "Скопіювати"

msgid "Variants"
msgstr "Варіанти"

msgid "A test can have several variants: parallel versions with different questions. Every student gets one of them, in turn, so neighbours answer different questions. Ask the assistant for them with the “Кількість варіантів” line of the prompt, or press “Add a variant” on the page of a test and change the copied questions."
msgstr "Тест може мати кілька варіантів: паралельні версії з різними питаннями. Кожен учень отримує один із них, по черзі, тож сусіди по парті відповідають на різні питання. Попросіть їх в асистента рядком «Кількість варіантів» у промпті або натисніть «Додати варіант» на сторінці тесту і змініть скопійовані питання."

msgid "%(n)s variant, given to students in turn"
msgid_plural "%(n)s variants, given to students in turn"
msgstr[0] "%(n)s варіант, учні отримують їх по черзі"
msgstr[1] "%(n)s варіанти, учні отримують їх по черзі"
msgstr[2] "%(n)s варіантів, учні отримують їх по черзі"

msgid "Variant"
msgstr "Варіант"

msgid "%(n)s finished attempt"
msgid_plural "%(n)s finished attempts"
msgstr[0] "%(n)s завершена спроба"
msgstr[1] "%(n)s завершені спроби"
msgstr[2] "%(n)s завершених спроб"
