{
  // Cross-platform: no hard-coded paths. Python tasks use the interpreter selected in VS Code
  // (the workspace .venv created by `uv sync`). `uv` itself must be on PATH (https://docs.astral.sh/uv/).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv sync (creates .venv)",
      "type": "process",
      "command": "uv",
      "args": ["sync", "--extra", "xlsx"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "sandbox: migrate",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["manage.py", "migrate", "-v0"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "KT_DATA_DIR": "${userHome}/.knowledge-tester-sandbox" }
      },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "sandbox: migrate + seed_demo",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["manage.py", "seed_demo"],
      "dependsOn": ["sandbox: migrate"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "KT_DATA_DIR": "${userHome}/.knowledge-tester-sandbox" }
      },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Sandbox: reset (delete throw-away data dir)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-c",
        "import shutil, sys; shutil.rmtree(sys.argv[1], ignore_errors=True); print('Sandbox data removed.')",
        "${userHome}/.knowledge-tester-sandbox"
      ],
      "problemMatcher": []
    },
    {
      "label": "ruff: check",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "check", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ruff: format",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "format", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ruff: check + format",
      "dependsOn": ["ruff: check", "ruff: format"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "ruff: format --check",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "format", "--check", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "pytest",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Quality gate: ruff + pytest",
      "dependsOn": ["ruff: check", "ruff: format --check", "pytest"],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
