{
  // The interpreter is auto-detected from the workspace's .venv (created by `uv sync`);
  // pick it once with "Python: Select Interpreter" if VS Code has not.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["-q"],
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
  "files.eol": "\n"
}
