{
  // Manual-tryout launchers. Work on any clone and OS: the interpreter is the one selected in VS Code
  // (Python: Select Interpreter), which auto-detects the workspace .venv created by `uv sync`.
  // "Real" data dir: the app default (%LOCALAPPDATA%\KnowledgeTester on Windows,
  // ~/.local/share/knowledge-tester elsewhere, or KT_DATA_DIR).
  // "Sandbox" data dir: ~/.knowledge-tester-sandbox (throw-away; wipe it with the "Sandbox: reset" task).
  // The quality gate is the task "Quality gate: ruff + pytest" (Terminal > Run Task).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev server (runserver, debug, real data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "127.0.0.1:8000"],
      "django": true,
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "LAN server for phones (serve, real data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["serve", "--port", "8000"],
      "console": "integratedTerminal",
      "subProcess": true,
      "justMyCode": true
    },
    {
      "name": "Sandbox: seed + dev server (debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "127.0.0.1:8001"],
      "django": true,
      "console": "integratedTerminal",
      "env": { "KT_DATA_DIR": "${userHome}/.knowledge-tester-sandbox" },
      "preLaunchTask": "sandbox: migrate + seed_demo",
      "justMyCode": true
    },
    {
      "name": "Sandbox: seed + LAN server for phones",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["serve", "--port", "8001"],
      "console": "integratedTerminal",
      "subProcess": true,
      "env": { "KT_DATA_DIR": "${userHome}/.knowledge-tester-sandbox" },
      "preLaunchTask": "sandbox: migrate + seed_demo",
      "justMyCode": true
    },
    {
      "name": "Migrate (real data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["migrate"],
      "console": "integratedTerminal"
    },
    {
      "name": "Seed demo users + sample test (real data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["seed_demo"],
      "console": "integratedTerminal"
    },
    {
      "name": "Create superuser (real data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["createsuperuser"],
      "console": "integratedTerminal"
    },
    {
      "name": "Import test from JSON file (asks for path, real data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "import_test",
        "${input:jsonFile}",
        "--project",
        "${input:projectTitle}",
        "--user",
        "${input:username}"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Export JSON Schema (schema/test.v1.schema.json)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["export_schema"],
      "console": "integratedTerminal"
    },
    {
      "name": "Django shell (real data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["shell"],
      "console": "integratedTerminal"
    },
    {
      "name": "Tests: all (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-x", "-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Tests: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "jsonFile",
      "type": "promptString",
      "description": "Path to a Test Document JSON file",
      "default": "docs/examples/full.json"
    },
    {
      "id": "projectTitle",
      "type": "promptString",
      "description": "Project to import into (created if missing)",
      "default": "My tests"
    },
    {
      "id": "username",
      "type": "promptString",
      "description": "Owner username",
      "default": "teacher"
    }
  ]
}
