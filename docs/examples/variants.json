{
  "format": "knowledge-tester/test",
  "version": 1,
  "test": {
    "title": "Fractions: two variants",
    "description": "The same skills in both variants, different numbers. Every student gets one of them.",
    "language": "en",
    "settings": {
      "time_limit_minutes": 10,
      "shuffle_options": true,
      "show_result": "score",
      "max_attempts": 1
    },
    "grading": { "scale": "percent" },
    "variants": [
      {
        "title": "Variant 1",
        "questions": [
          {
            "type": "single_choice",
            "text": "Which fraction equals 1/2?",
            "points": 1,
            "options": [
              { "text": "2/4", "correct": true },
              { "text": "2/3" },
              { "text": "3/4" },
              { "text": "1/4" }
            ]
          },
          {
            "type": "multiple_choice",
            "text": "Select every fraction greater than 1/2.",
            "points": 2,
            "options": [
              { "text": "3/4", "correct": true },
              { "text": "2/3", "correct": true },
              { "text": "1/4" },
              { "text": "2/5" }
            ]
          },
          {
            "type": "short_answer",
            "text": "Write 3/4 as a decimal number.",
            "points": 1,
            "mode": "numeric",
            "accept": ["0.75"]
          }
        ]
      },
      {
        "title": "Variant 2",
        "questions": [
          {
            "type": "single_choice",
            "text": "Which fraction equals 1/3?",
            "points": 1,
            "options": [
              { "text": "2/6", "correct": true },
              { "text": "2/3" },
              { "text": "3/6" },
              { "text": "1/6" }
            ]
          },
          {
            "type": "multiple_choice",
            "text": "Select every fraction smaller than 1/2.",
            "points": 2,
            "options": [
              { "text": "1/4", "correct": true },
              { "text": "2/5", "correct": true },
              { "text": "3/4" },
              { "text": "2/3" }
            ]
          },
          {
            "type": "short_answer",
            "text": "Write 1/4 as a decimal number.",
            "points": 1,
            "mode": "numeric",
            "accept": ["0.25"]
          }
        ]
      }
    ]
  }
}
